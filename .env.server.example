APP_IMAGE=ghcr.io/cda1234567/dispatch-scheduler:latest
APP_CONTAINER_NAME=dispatch-scheduler
CADDY_CONTAINER_NAME=dispatch-caddy
APP_DOMAIN=cda1234567.com
ACME_EMAIL=you@example.com
APP_UPSTREAM=dispatch-scheduler:8765
APP_BASIC_AUTH_USER=admin
APP_BASIC_AUTH_PASSWORD_HASH='$2b$12$Soo61t0XpKANoBu0jiWNmuiP6gaIf.i3TlfZO/L4sn.YkQ4LsM2IO'
WATCHTOWER_CONTAINER_NAME=dispatch-watchtower
WATCHTOWER_SCOPE=dispatch-scheduler
WATCHTOWER_POLL_INTERVAL=60
WATCHTOWER_DOCKER_API_VERSION=1.44
# 正航 ERP SQL Server（ST 庫存唯讀查詢；帳密請自行填入，勿提交）
ERP_SQL_SERVER=10.0.0.1
ERP_SQL_PORT=1433
ERP_SQL_DATABASE=CHIComp03
ERP_SQL_USER=
ERP_SQL_PASSWORD=
ERP_ST_WARE_ID=001
ERP_SQL_TIMEOUT=5
ERP_SQL_ENCRYPTION=off
ERP_SQL_TDS_VERSION=7.3
# ST 庫存從正航 ERP 自動同步間隔（分鐘）：預設 60；0 = 關閉（只能手動按「從正航更新」）；最小 5
# 同步 = 以 ERP 庫存整批取代本機快照（等同上傳新 Excel）；ERP 失敗/0 筆/筆數暴跌時不會動本機快照
ERP_ST_AUTO_SYNC_MINUTES=60
