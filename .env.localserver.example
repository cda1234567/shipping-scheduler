APP_IMAGE=dispatch-scheduler:test
APP_PORT=18765
APP_CONTAINER_NAME=dispatch-scheduler-localserver
APP_DATA_VOLUME=scheduler-data
WATCHTOWER_CONTAINER_NAME=dispatch-watchtower-localserver
WATCHTOWER_SCOPE=dispatch-local
WATCHTOWER_POLL_INTERVAL=300
WATCHTOWER_DOCKER_API_VERSION=1.44

# ST 庫存從正航 ERP 自動同步間隔（分鐘）：預設 60；0 = 關閉（只能手動按「從正航更新」）；最小 5
# 同步 = 以 ERP 庫存整批取代本機快照（等同上傳新 Excel）；ERP 失敗/0 筆/筆數暴跌時不會動本機快照
ERP_ST_AUTO_SYNC_MINUTES=60

# 一次收料（收料 / 驗收 / 進貨）寫入公司；空 = 沿用 ERP_WRITE_TARGET（開採購單）
# 寫入正式公司3：ERP_RECEIVE_TARGET=CHIComp03 且 ERP_ALLOW_PROD_WRITE_CHICOMP03=1，
# 並在 env_file（例如 D:/secrets/shipping-erp-comp03-write.env）設 ERP_SQL_WRITE_SERVER_CHICOMP03 / ERP_SQL_WRITE_USER_CHICOMP03 / ERP_SQL_WRITE_PASSWORD_CHICOMP03
ERP_RECEIVE_TARGET=
ERP_ALLOW_PROD_WRITE_CHICOMP03=0
# 一次收料「更新平均成本」預設值：1 = 更新、0 = 不更新（畫面可逐次改）
ERP_RECEIVE_UPDATE_COST=1
# 採購單「已寄 / 未寄 / 廠商已回」狀態：唯讀向 automail（Andy 的寄信網站）讀 /api/sendlog 與 /api/replies，本站不寄信
# AUTOMAIL_BASE_URL 設 off 停用；AUTOMAIL_REFRESH_SECONDS 為快取秒數（最小 30）
AUTOMAIL_BASE_URL=https://automail.cda.tw
AUTOMAIL_REFRESH_SECONDS=180
